{
  "name": "lucid-ui",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "pnpm --filter @pandaworks-sw/demo dev",
    "build": "pnpm --filter @pandaworks-sw/lucid-ui build:lib && pnpm --filter @pandaworks-sw/demo build",
    "lint": "biome check && pnpm --filter @pandaworks-sw/demo lint",
    "lint:fix": "biome check --fix",
    "format": "biome format --write",
    "format:check": "biome format",
    "test:ui-audit": "node scripts/ui-audit-playwright.mjs --serve",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.4.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.59.1",
    "vitest": "^5.0.0"
  }
}
